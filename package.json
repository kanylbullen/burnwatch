{
  "name": "burnwatch",
  "version": "0.1.0",
  "description": "Desk widget for your Claude Code rate limits: how much of the weekly and 5-hour allowance is gone, how fast you are burning it, and whether you run dry before the reset",
  "license": "MIT",
  "author": "kanylbullen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanylbullen/burnwatch.git"
  },
  "homepage": "https://github.com/kanylbullen/burnwatch#readme",
  "bugs": {
    "url": "https://github.com/kanylbullen/burnwatch/issues"
  },
  "keywords": [
    "claude-code",
    "rate-limit",
    "usage",
    "burn-rate",
    "widget",
    "tauri",
    "statusline"
  ],
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply burnwatch --remote",
    "db:migrate:local": "wrangler d1 migrations apply burnwatch --local",
    "selfhost": "bun run daemon/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
