{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "burnwatch",
  "version": "0.1.0",
  "identifier": "io.github.kanylbullen.burnwatch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' http://*:* https://*:*",
      "capabilities": ["widget"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
